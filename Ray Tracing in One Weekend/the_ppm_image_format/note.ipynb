   "source": [
    "from PIL import Image\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img = Image.open(\"image.ppm\")\n",
    "\n",
    "scale = 10\n",
    "zoomed = img.resize(\n",
    "    (img.width * scale, img.height * scale),\n",
    "    Image.NEAREST\n",
    ")\n",
    "\n",
    "plt.imshow(zoomed)\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
  },
